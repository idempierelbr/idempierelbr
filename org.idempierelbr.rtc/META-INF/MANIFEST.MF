Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: iDempiereLBR - Apuração do Fisco (RTC)
Bundle-SymbolicName: org.idempierelbr.rtc
Bundle-Version: 13.0.0.qualifier
Bundle-Vendor: iDempiereLBR
Bundle-ClassPath: .
Require-Bundle: org.adempiere.base,
 org.idempierelbr.core,
 org.idempierelbr.base,
 jakarta.ws.rs-api,
 org.glassfish.jersey.containers.jersey-container-servlet-core;bundle-version="2.34.0"
Web-ContextPath: rtc
Jetty-Environment: ee8
Service-Component: OSGI-INF/*.xml
Bundle-ActivationPolicy: lazy
Import-Package: com.google.gson;version="2.9.0",
 com.google.gson.annotations;version="2.9.0",
 com.google.gson.reflect;version="2.9.0",
 org.osgi.framework,
 org.osgi.service.event
Export-Package: org.idempierelbr.rtc.client,
 org.idempierelbr.rtc.json,
 org.idempierelbr.rtc.json.dto,
 org.idempierelbr.rtc.process,
 org.idempierelbr.rtc.provider,
 org.idempierelbr.rtc.service,
 org.idempierelbr.rtc.util
