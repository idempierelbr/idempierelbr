<?xml version="1.0" encoding="UTF-8"?>
<!--
  DAMDFE - Documento Auxiliar do Manifesto Eletronico de Documentos Fiscais.
  Modal rodoviario, no leiaute retrato do ACBr: as posicoes, fontes e linhas
  sao as de um DAMDFE impresso por ele.

  Sem consulta SQL: os dados chegam prontos de DAMDFEDados, para o papel nunca
  divergir do XML que foi autorizado. O detalhe e a relacao de documentos, um
  grupo por municipio de descarga.

  Times New Roman vem do fragmento org.idempierelbr.jasperfonts (Liberation
  Serif, de mesmas metricas, embutida no PDF).

  Da segunda folha em diante saem so o cabecalho e a continuacao da relacao:
  veiculo, condutor, vale-pedagio, seguro, totais e observacao ficam na
  primeira, como no ACBr.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="Damdfe" pageWidth="595" pageHeight="842" columnWidth="595"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0"
              whenNoDataType="AllSectionsNoDetail" isIgnorePagination="false">

	<style name="base" isDefault="true" fontName="Times New Roman" fontSize="8"/>
	<style name="n5" style="base" fontSize="5"/>
	<style name="n6" style="base" fontSize="6"/>
	<style name="n7" style="base" fontSize="7"/>
	<style name="n8" style="base" fontSize="8"/>
	<style name="n10" style="base" fontSize="10"/>
	<style name="b5" style="base" fontSize="5" isBold="true"/>
	<style name="b6" style="base" fontSize="6" isBold="true"/>
	<style name="b7" style="base" fontSize="7" isBold="true"/>
	<style name="b8" style="base" fontSize="8" isBold="true"/>
	<style name="b10" style="base" fontSize="10" isBold="true"/>
	<style name="b12" style="base" fontSize="12" isBold="true"/>
	<style name="b14" style="base" fontSize="14" isBold="true"/>
	<style name="linha"><pen lineWidth="0.75"/></style>

	<parameter name="emit_nome" class="java.lang.String"/>
	<parameter name="emit_linhas" class="java.lang.String"/>
	<parameter name="logotipo" class="java.io.InputStream" isForPrompting="false"/>
	<parameter name="modelo" class="java.lang.String"/>
	<parameter name="serie" class="java.lang.String"/>
	<parameter name="numero" class="java.lang.String"/>
	<parameter name="data_emissao" class="java.lang.String"/>
	<parameter name="uf_ini" class="java.lang.String"/>
	<parameter name="uf_fim" class="java.lang.String"/>
	<parameter name="chave" class="java.lang.String"/>
	<parameter name="protocolo" class="java.lang.String"/>
	<parameter name="barcode" class="java.awt.Image"/>
	<parameter name="qrcode" class="java.awt.Image"/>
	<parameter name="placas" class="java.lang.String"/>
	<parameter name="rntrcs" class="java.lang.String"/>
	<parameter name="cpfs" class="java.lang.String"/>
	<parameter name="nomes" class="java.lang.String"/>
	<parameter name="vp_responsaveis" class="java.lang.String"/>
	<parameter name="vp_fornecedores" class="java.lang.String"/>
	<parameter name="vp_comprovantes" class="java.lang.String"/>
	<parameter name="seg_responsavel" class="java.lang.String"/>
	<parameter name="seguradoras" class="java.lang.String"/>
	<parameter name="apolices" class="java.lang.String"/>
	<parameter name="qtd_cte" class="java.lang.String"/>
	<parameter name="qtd_nfe" class="java.lang.String"/>
	<parameter name="qtd_mdfe" class="java.lang.String"/>
	<parameter name="peso_rotulo" class="java.lang.String"/>
	<parameter name="peso_total" class="java.lang.String"/>
	<parameter name="valor_carga" class="java.lang.String"/>
	<parameter name="observacoes" class="java.lang.String"/>
	<parameter name="aviso" class="java.lang.String"/>
	<parameter name="data_impressao" class="java.lang.String"/>

	<field name="municipio_id" class="java.lang.Integer"/>
	<field name="municipio" class="java.lang.String"/>
	<field name="tipo_esq" class="java.lang.String"/>
	<field name="chave_esq" class="java.lang.String"/>
	<field name="tipo_dir" class="java.lang.String"/>
	<field name="chave_dir" class="java.lang.String"/>

	<!-- Uma vez, na primeira folha: veiculo, condutor, vale-pedagio, seguro e totais. -->
	<group name="rodo">
		<groupExpression><![CDATA[Boolean.TRUE]]></groupExpression>
		<groupHeader>
			<band height="199" splitType="Prevent">
				<staticText><reportElement style="n8" x="22" y="3" width="200" height="10"/><text><![CDATA[Veículo]]></text></staticText>
				<staticText><reportElement style="n8" x="257" y="3" width="200" height="10"/><text><![CDATA[Condutor]]></text></staticText>
				<line><reportElement style="linha" x="18" y="14" width="562" height="0"/></line>
				<staticText><reportElement style="n8" x="22" y="18" width="110" height="10"/><text><![CDATA[Placa]]></text></staticText>
				<staticText><reportElement style="n8" x="145" y="18" width="100" height="10"/><text><![CDATA[RNTRC]]></text></staticText>
				<staticText><reportElement style="n8" x="257" y="18" width="60" height="10"/><text><![CDATA[CPF]]></text></staticText>
				<staticText><reportElement style="n8" x="328" y="18" width="200" height="10"/><text><![CDATA[Nome]]></text></staticText>
				<line><reportElement style="linha" x="18" y="29" width="562" height="0"/></line>
				<line><reportElement style="linha" x="139" y="14" width="0" height="60"/></line>
				<line><reportElement style="linha" x="324" y="14" width="0" height="61"/></line>
				<line><reportElement style="linha" x="254" y="0" width="0" height="155"/></line>
				<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement style="n7" x="21" y="33" width="113" height="39"/><textFieldExpression><![CDATA[$P{placas}]]></textFieldExpression></textField>
				<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement style="n7" x="144" y="33" width="106" height="39"/><textFieldExpression><![CDATA[$P{rntrcs}]]></textFieldExpression></textField>
				<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement style="n7" x="256" y="33" width="64" height="39"/><textFieldExpression><![CDATA[$P{cpfs}]]></textFieldExpression></textField>
				<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement style="n7" x="327" y="33" width="244" height="39"/><textFieldExpression><![CDATA[$P{nomes}]]></textFieldExpression></textField>
				<line><reportElement style="linha" x="18" y="75" width="562" height="0"/></line>

				<staticText><reportElement style="n8" x="22" y="78" width="200" height="10"/><text><![CDATA[Vale Pedágio]]></text></staticText>
				<textField isBlankWhenNull="true"><reportElement style="n8" x="258" y="78" width="310" height="10"/><textFieldExpression><![CDATA["Responsável pelo Seguro - " + ($P{seg_responsavel} == null ? "" : $P{seg_responsavel})]]></textFieldExpression></textField>
				<line><reportElement style="linha" x="18" y="89" width="562" height="0"/></line>
				<staticText><reportElement style="n8" x="22" y="93" width="66" height="10"/><text><![CDATA[Responsável CNPJ]]></text></staticText>
				<staticText><reportElement style="n8" x="92" y="93" width="70" height="10"/><text><![CDATA[Fornecedor CNPJ]]></text></staticText>
				<staticText><reportElement style="n8" x="166" y="93" width="88" height="10"/><text><![CDATA[N. Comprovante]]></text></staticText>
				<staticText><reportElement style="n8" x="258" y="93" width="160" height="10"/><text><![CDATA[Nome da Seguradora]]></text></staticText>
				<staticText><reportElement style="n8" x="423" y="93" width="150" height="10"/><text><![CDATA[Número da Apólice]]></text></staticText>
				<line><reportElement style="linha" x="89" y="89" width="0" height="66"/></line>
				<line><reportElement style="linha" x="162" y="89" width="0" height="66"/></line>
				<line><reportElement style="linha" x="419" y="89" width="0" height="66"/></line>
				<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement style="n7" x="21" y="105" width="65" height="39"/><textFieldExpression><![CDATA[$P{vp_responsaveis}]]></textFieldExpression></textField>
				<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement style="n7" x="93" y="105" width="65" height="39"/><textFieldExpression><![CDATA[$P{vp_fornecedores}]]></textFieldExpression></textField>
				<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement style="n7" x="165" y="105" width="86" height="39"/><textFieldExpression><![CDATA[$P{vp_comprovantes}]]></textFieldExpression></textField>
				<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement style="n7" x="257" y="106" width="161" height="39"/><textFieldExpression><![CDATA[$P{seguradoras}]]></textFieldExpression></textField>
				<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement style="n7" x="422" y="105" width="149" height="39"/><textFieldExpression><![CDATA[$P{apolices}]]></textFieldExpression></textField>
				<line><reportElement style="linha" x="18" y="155" width="562" height="0"/></line>

				<staticText><reportElement style="n8" x="16" y="157" width="562" height="10"/><textElement textAlignment="Center"/><text><![CDATA[MODAL RODOVIÁRIO DE CARGA]]></text></staticText>
				<line><reportElement style="linha" x="18" y="166" width="562" height="0"/></line>
				<staticText><reportElement style="n8" x="25" y="172" width="90" height="10"/><text><![CDATA[QTDE CT-e]]></text></staticText>
				<staticText><reportElement style="n8" x="128" y="172" width="85" height="10"/><text><![CDATA[QTDE NF-e]]></text></staticText>
				<staticText><reportElement style="n8" x="224" y="172" width="90" height="10"/><text><![CDATA[QTDE MDF-e]]></text></staticText>
				<textField isBlankWhenNull="true"><reportElement style="n8" x="324" y="172" width="125" height="10"/><textFieldExpression><![CDATA[$P{peso_rotulo}]]></textFieldExpression></textField>
				<staticText><reportElement style="n8" x="459" y="172" width="120" height="10"/><text><![CDATA[VALOR DA MERCADORIA R$]]></text></staticText>
				<line><reportElement style="linha" x="120" y="165" width="0" height="32"/></line>
				<line><reportElement style="linha" x="216" y="165" width="0" height="32"/></line>
				<line><reportElement style="linha" x="318" y="165" width="0" height="32"/></line>
				<line><reportElement style="linha" x="453" y="165" width="0" height="32"/></line>
				<textField isBlankWhenNull="true"><reportElement style="n10" x="25" y="183" width="62" height="12"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$P{qtd_cte}]]></textFieldExpression></textField>
				<textField isBlankWhenNull="true"><reportElement style="n10" x="128" y="183" width="62" height="12"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$P{qtd_nfe}]]></textFieldExpression></textField>
				<textField isBlankWhenNull="true"><reportElement style="n10" x="224" y="183" width="62" height="12"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$P{qtd_mdfe}]]></textFieldExpression></textField>
				<textField isBlankWhenNull="true"><reportElement style="n10" x="324" y="183" width="111" height="12"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$P{peso_total}]]></textFieldExpression></textField>
				<textField isBlankWhenNull="true"><reportElement style="n10" x="459" y="183" width="107" height="12"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$P{valor_carga}]]></textFieldExpression></textField>
				<line><reportElement style="linha" x="18" y="198" width="562" height="0"/></line>
			</band>
		</groupHeader>
	</group>

	<!-- Titulo e colunas da relacao, repetidos no alto de cada folha. -->
	<group name="relacao" isReprintHeaderOnEachPage="true">
		<groupExpression><![CDATA[Boolean.TRUE]]></groupExpression>
		<groupHeader>
			<band height="23" splitType="Prevent">
				<staticText><reportElement style="b7" x="30" y="3" width="550" height="9"/><textElement textAlignment="Center"/><text><![CDATA[RELAÇÃO DOS DOCUMENTOS FISCAIS ELETRÔNICOS]]></text></staticText>
				<staticText><reportElement style="n5" x="22" y="16" width="40" height="6"/><text><![CDATA[TP DOC.]]></text></staticText>
				<staticText><reportElement style="n5" x="85" y="16" width="60" height="6"/><text><![CDATA[CNPJ/CPF EMITENTE]]></text></staticText>
				<staticText><reportElement style="n5" x="149" y="16" width="80" height="6"/><text><![CDATA[SÉRIE/NRO. DOCUMENTO]]></text></staticText>
				<staticText><reportElement style="n5" x="304" y="16" width="40" height="6"/><text><![CDATA[TP DOC.]]></text></staticText>
				<staticText><reportElement style="n5" x="367" y="16" width="60" height="6"/><text><![CDATA[CNPJ/CPF EMITENTE]]></text></staticText>
				<staticText><reportElement style="n5" x="431" y="16" width="80" height="6"/><text><![CDATA[SÉRIE/NRO. DOCUMENTO]]></text></staticText>
				<line><reportElement style="linha" x="18" y="22" width="562" height="0"/></line>
			</band>
		</groupHeader>
	</group>

	<!-- Um grupo por municipio de descarga; a primeira linha do bloco fica em branco, como no ACBr. -->
	<group name="municipio" isReprintHeaderOnEachPage="true" minHeightToStartNewPage="34">
		<groupExpression><![CDATA[$F{municipio_id}]]></groupExpression>
		<groupHeader>
			<band height="22" splitType="Prevent">
				<printWhenExpression><![CDATA[$F{municipio_id} != null]]></printWhenExpression>
				<textField isBlankWhenNull="true"><reportElement style="n8" x="19" y="1" width="560" height="10"/><textFieldExpression><![CDATA["Município " + ($F{municipio} == null ? "" : $F{municipio}) + " "]]></textFieldExpression></textField>
				<line><reportElement style="linha" x="18" y="11" width="562" height="0"/></line>
				<line><reportElement style="linha" x="298" y="12" width="0" height="10"/></line>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="1">
				<printWhenExpression><![CDATA[$F{municipio_id} != null]]></printWhenExpression>
				<line><reportElement style="linha" x="18" y="0" width="562" height="0"/></line>
			</band>
		</groupFooter>
	</group>

	<background>
		<band height="842">
			<rectangle><reportElement style="linha" x="18" y="23" width="563" height="796"/><graphicElement><pen lineWidth="0.75"/></graphicElement></rectangle>
		</band>
	</background>

	<!-- Cabecalho de toda folha: emitente, codigo de barras, chave, QR Code, protocolo e identificacao. -->
	<pageHeader>
		<band height="174" splitType="Prevent">
			<line><reportElement style="linha" x="265" y="23" width="0" height="126"/></line>

			<textField isBlankWhenNull="true"><reportElement style="b8" x="23" y="32" width="231" height="28"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$P{emit_nome}]]></textFieldExpression></textField>
			<image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" isUsingCache="false">
				<reportElement x="23" y="64" width="74" height="80"><printWhenExpression><![CDATA[$P{logotipo} != null]]></printWhenExpression></reportElement>
				<imageExpression><![CDATA[$P{logotipo}]]></imageExpression>
			</image>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement style="n7" x="100" y="64" width="155" height="81"/><textElement><paragraph lineSpacing="Fixed" lineSpacingSize="7.9"/></textElement><textFieldExpression><![CDATA[$P{emit_linhas}]]></textFieldExpression></textField>

			<staticText><reportElement style="b14" x="268" y="26" width="67" height="17"/><text><![CDATA[DAMDFE]]></text></staticText>
			<staticText><reportElement style="n8" x="335" y="30" width="245" height="10"/><text><![CDATA[Documento Auxiliar de Manifesto Eletrônico de Documentos Fiscais]]></text></staticText>
			<line><reportElement style="linha" x="265" y="43" width="315" height="0"/></line>
			<staticText><reportElement style="b6" x="270" y="46" width="100" height="8"/><text><![CDATA[Controle do Fisco]]></text></staticText>
			<image scaleImage="FillFrame" isUsingCache="false">
				<reportElement x="272" y="56" width="217" height="31"/>
				<imageExpression><![CDATA[$P{barcode}]]></imageExpression>
			</image>
			<line><reportElement style="linha" x="265" y="96" width="230" height="0"/></line>
			<staticText><reportElement style="b6" x="268" y="96" width="100" height="8"/><text><![CDATA[Chave de acesso]]></text></staticText>
			<textField isBlankWhenNull="true"><reportElement style="b8" x="270" y="111" width="223" height="11"/><textFieldExpression><![CDATA[$P{chave}]]></textFieldExpression></textField>
			<line><reportElement style="linha" x="495" y="43" width="0" height="82"/></line>
			<image scaleImage="FillFrame" isUsingCache="false">
				<reportElement x="499" y="44" width="80" height="80"/>
				<imageExpression><![CDATA[$P{qrcode}]]></imageExpression>
			</image>
			<line><reportElement style="linha" x="265" y="125" width="315" height="0"/></line>
			<staticText><reportElement style="b5" x="268" y="130" width="200" height="7"/><text><![CDATA[PROTOCOLO DE AUTORIZAÇÃO DE USO]]></text></staticText>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement style="b8" x="268" y="139" width="281" height="10"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$P{protocolo}]]></textFieldExpression></textField>
			<line><reportElement style="linha" x="18" y="149" width="562" height="0"/></line>

			<staticText><reportElement style="n5" x="19" y="155" width="24" height="6"/><text><![CDATA[MODELO]]></text></staticText>
			<staticText><reportElement style="n5" x="48" y="155" width="16" height="6"/><text><![CDATA[SÉRIE]]></text></staticText>
			<staticText><reportElement style="n5" x="66" y="155" width="53" height="6"/><textElement textAlignment="Center"/><text><![CDATA[NÚMERO]]></text></staticText>
			<staticText><reportElement style="n5" x="120" y="155" width="24" height="6"/><textElement textAlignment="Center"/><text><![CDATA[FOLHA]]></text></staticText>
			<staticText><reportElement style="n5" x="146" y="155" width="78" height="6"/><textElement textAlignment="Center"/><text><![CDATA[DATA E HORA DE EMISSÃO]]></text></staticText>
			<staticText><reportElement style="n5" x="228" y="155" width="26" height="6"/><text><![CDATA[UF Carrega]]></text></staticText>
			<staticText><reportElement style="n5" x="256" y="155" width="26" height="6"/><text><![CDATA[UF Descar.]]></text></staticText>
			<textField isBlankWhenNull="true"><reportElement style="b8" x="19" y="162" width="22" height="10"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$P{modelo}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement style="b8" x="47" y="162" width="15" height="10"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$P{serie}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement style="b10" x="65" y="161" width="54" height="12"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$P{numero}]]></textFieldExpression></textField>
			<textField textAdjust="ScaleFont" evaluationTime="Master"><reportElement style="b8" x="119" y="163" width="24" height="10"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[String.format("%02d/%02d", $V{MASTER_CURRENT_PAGE}, $V{MASTER_TOTAL_PAGES})]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement style="b8" x="148" y="162" width="77" height="10"/><textFieldExpression><![CDATA[$P{data_emissao}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement style="b7" x="227" y="162" width="26" height="9"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$P{uf_ini}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement style="b7" x="256" y="162" width="25" height="9"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$P{uf_fim}]]></textFieldExpression></textField>
			<line><reportElement style="linha" x="44" y="149" width="0" height="23"/></line>
			<line><reportElement style="linha" x="64" y="149" width="0" height="23"/></line>
			<line><reportElement style="linha" x="119" y="149" width="0" height="23"/></line>
			<line><reportElement style="linha" x="145" y="149" width="0" height="23"/></line>
			<line><reportElement style="linha" x="226" y="149" width="0" height="23"/></line>
			<line><reportElement style="linha" x="254" y="149" width="0" height="23"/></line>
			<line><reportElement style="linha" x="18" y="173" width="562" height="0"/></line>
		</band>
	</pageHeader>

	<detail>
		<band height="11" splitType="Prevent">
			<textField isBlankWhenNull="true"><reportElement style="n8" x="20" y="1" width="34" height="10"/><textFieldExpression><![CDATA[$F{tipo_esq}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement style="n8" x="56" y="1" width="240" height="10"/><textFieldExpression><![CDATA[$F{chave_esq}]]></textFieldExpression></textField>
			<line><reportElement style="linha" x="298" y="0" width="0" height="11"/></line>
			<textField isBlankWhenNull="true"><reportElement style="n8" x="304" y="1" width="34" height="10"/><textFieldExpression><![CDATA[$F{tipo_dir}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement style="n8" x="340" y="1" width="238" height="10"/><textFieldExpression><![CDATA[$F{chave_dir}]]></textFieldExpression></textField>
		</band>
	</detail>

	<!-- Observacao so na primeira folha, como no ACBr; a data da impressao em todas. -->
	<pageFooter>
		<band height="137">
			<line><reportElement style="linha" x="18" y="0" width="562" height="0"/></line>
			<staticText><reportElement style="n8" x="22" y="4" width="200" height="10"><printWhenExpression><![CDATA[$V{PAGE_NUMBER} == 1]]></printWhenExpression></reportElement><text><![CDATA[Observação]]></text></staticText>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement style="n7" x="19" y="13" width="558" height="55"><printWhenExpression><![CDATA[$V{PAGE_NUMBER} == 1]]></printWhenExpression></reportElement><textFieldExpression><![CDATA[$P{observacoes}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement style="b12" x="18" y="72" width="562" height="16"><printWhenExpression><![CDATA[$V{PAGE_NUMBER} == 1]]></printWhenExpression></reportElement><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$P{aviso}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement style="n6" x="19" y="105" width="250" height="8"/><textFieldExpression><![CDATA["DATA E HORA DA IMPRESSÃO: " + ($P{data_impressao} == null ? "" : $P{data_impressao})]]></textFieldExpression></textField>
		</band>
	</pageFooter>
</jasperReport>
